    {
      "id": 21,
      "type": "stat",
      "title": "etcd endpoints healthy",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 41,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min by (endpoint) (katam_etcd_endpoint_healthy)",
          "legendFormat": "{{endpoint}}"
